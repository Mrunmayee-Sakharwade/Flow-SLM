      }
    },
    {
      "id": "resp:FRM:27",
      "label": "ExclusionRule",
      "properties": {
        "text": "Never include clinical operational workflows (e.g., electronic ordering systems, prophylaxis drop-down menus, EHR treatment ordering).",
