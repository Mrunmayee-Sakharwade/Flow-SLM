    {
      "id": "resp:FRM:13",
      "label": "CoreResponsibility",
      "properties": {
        "text": "Building and maintaining relationships with reimbursement specialists, office staff, practice administrators, patient access teams, financial counselors, specialty pharmacies, and other stakeholders involved in reimbursement and patient access.",
        "category": "core",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "affordability_patient_support",
          "patient_access",
          "relationship_building",
          "stakeholder_management"
        ]
      }
    },
    {
      "id": "resp:FRM:14",
      "label": "CollaborationRule",
      "properties": {
        "text": "Educating healthcare accounts on payer coverage policies, reimbursement processes, prior authorization requirements, benefits verification, claims and appeals processes, specialty pharmacy coordination, and approved reimbursement and patient support resources.",
        "category": "collaboration",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "prior_authorization",
          "payer_coverage",
          "cross_functional_collaboration"
        ]
      }
    },
    {
      "id": "resp:FRM:15",
      "label": "DocumentationRule",
      "properties": {
        "text": "Gathering customer insights specifically related to reimbursement processes, payer requirements, coverage policies, prior authorization status, benefits verification outcomes, affordability considerations, and patient access experiences — documented instances include payer coverage decisions, reimbursement barriers, access challenges, and patient support program utilization.",
        "category": "documentation",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "prior_authorization",
          "payer_coverage",
          "affordability_patient_support",
          "patient_access"
        ]
      }
    },
    {
      "id": "resp:FRM:16",
      "label": "ExclusionRule",
      "properties": {
        "text": "Adherence to clinical treatment protocols, medication adherence strategies, and mitigation protocol education are NOT FRM insights and must not be included.",
        "category": "exclusion",
        "domain": "patient_access_reimbursement",
        "topics": []
      }
    },
    {
      "id": "resp:FRM:17",
      "label": "CoreResponsibility",
      "properties": {
        "text": "Identifying reimbursement and patient access barriers affecting appropriate access to approved products and discussing approved reimbursement resources, payer support services, financial assistance programs, reimbursement tools, and patient access resources that facilitate appropriate access to approved products.",
        "category": "core",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "affordability_patient_support",
          "patient_access"
        ]
      }
    },
    {
      "id": "resp:FRM:18",
      "label": "DocumentationRule",
      "properties": {
        "text": "Documenting reimbursement-related discussions, payer policy updates, reimbursement determinations, patient access challenges, approved support resources discussed, agreed actions, and reimbursement follow-up activities arising from customer interactions.",
        "category": "documentation",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "payer_coverage",
          "patient_access"
        ]
      }
    },
    {
      "id": "resp:FRM:19",
      "label": "DocumentationRule",
      "properties": {
        "text": "Gathering and documenting discussions related to patient support resources (e.g., copay assistance, patient assistance programs, caregiver financial support), office reimbursement workflows (e.g., billing processes, claims submission), affordability programs, and access-facilitation resources — documented instances include discussions about specific support programs available, enrollment processes, and affordability barriers.",
        "category": "documentation",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "affordability_patient_support"
        ]
      }
    },
    {
      "id": "resp:FRM:20",
      "label": "ExclusionRule",
      "properties": {
        "text": "Patient education materials, clinical adherence education, and treatment protocol guidance are NOT FRM patient support discussions and must not be included.",
        "category": "exclusion",
        "domain": "patient_access_reimbursement",
        "topics": []
      }
    },
    {
      "id": "resp:FRM:21",
      "label": "CoreResponsibility",
      "properties": {
        "text": "Supporting healthcare accounts in understanding reimbursement processes, navigating patient access pathways, utilizing approved patient support resources, and addressing reimbursement or coverage-related questions through approved education.",
        "category": "core",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "patient_access"
        ]
      }
    },
    {
      "id": "resp:FRM:22",
      "label": "CollaborationRule",
      "properties": {
        "text": "Coordinating with cross-functional partners (e.g., OS, KAM, MSL, OCE, PMAM, UBAM, Market Access, and Patient Support teams) only when customer needs extend beyond the FRM's functional responsibilities, and including cross-functional or clinical-operational coordination details only when they directly relate to reimbursement, coverage, prior authorization, affordability, or patient access workflows.",
        "category": "collaboration",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "prior_authorization",
          "affordability_patient_support",
          "patient_access",
          "cross_functional_collaboration"
        ]
      }
    },
    {
      "id": "resp:FRM:23",
      "label": "ExclusionRule",
      "properties": {
        "text": "If a call contains no in-scope reimbursement/access facts, record no FRM insight for that call.",
        "category": "exclusion",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement"
        ]
      }
    },
    {
      "id": "resp:FRM:24",
      "label": "ExclusionRule",
      "properties": {
        "text": "Excluding adverse event, safety, protocol-related, toxicity management, administration protocol, and other clinical management discussions from the summary. These topics are outside the FRM commercial scope and should be handled by the appropriate medical function in accordance with organizational policy.",
        "category": "exclusion",
        "domain": "patient_access_reimbursement",
        "topics": [
          "adverse_events_safety",
          "toxicity_management",
          "dosing_administration"
        ],
        "reason": "outside the FRM commercial scope and should be handled by the appropriate medical function in accordance with organizational policy."
      }
    },
    {
      "id": "resp:FRM:25",
      "label": "CoreResponsibility",
      "properties": {
        "text": "Gathering facts using only reimbursement, patient access, payer coverage, affordability, and patient financial support facts.",
        "category": "core",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "payer_coverage",
          "affordability_patient_support",
          "patient_access"
        ]
      }
    },
    {
      "id": "resp:FRM:26",
      "label": "CoreResponsibility",
      "properties": {
        "text": "Office operational facts are only in scope when they directly describe a reimbursement or access workflow (e.g., how billing is submitted, how prior authorization is processed).",
        "category": "core",
        "domain": "patient_access_reimbursement",
        "topics": [
          "reimbursement",
          "prior_authorization"
